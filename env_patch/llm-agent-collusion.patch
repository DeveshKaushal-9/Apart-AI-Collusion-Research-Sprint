+"""Offline check of the sprint additions (coalition messaging, message filter) with a stub model."""
+import json
+import random
+
+from src.continuous_double_auction.cda_types import ExperimentParams
+from src.continuous_double_auction.market.agents import LMBuyer, LMSeller, MessageFilter
+from src.continuous_double_auction.market.market import Market
+from src.resources.model_wrappers import ModelWrapper
+
+
+class StubClient(ModelWrapper):
+    def __init__(self):
+        super().__init__("stub")
+        self.prompts = []
+
+    def generate(self, messages):
+        prompt = messages[-1]["content"]
+        self.prompts.append(prompt)
+        if "trusted relay" in prompt:
+            senders = [line.split(":")[0].strip("- ").strip() for line in prompt.splitlines() if line.startswith("- Seller")]
+            return json.dumps({"messages": {s: "[filtered]" for s in senders}})
+        price = round(random.uniform(85, 95), 2)
+        return json.dumps({"ask": f"{price}", "bid": f"${price}", "message_to_sellers": "hold at 95", "new_memory": "m"})
+
+    def batch_generate(self, messages_list):
+        return [self.generate(m) for m in messages_list]
+
+
+def make_market(message_filter=None):
+    params = ExperimentParams(seller_valuations=[80] * 4, buyer_valuations=[100] * 4,
+                              seller_models=["local:x"] * 4, buyer_models=["local:x"] * 4, rounds=3,
+                              seller_comms_enabled=True, comms_group=[0, 1], message_filter=message_filter)
+    client = StubClient()
+    sellers = [LMSeller(id=f"Seller S{i}", company="c", valuation=80, expt_params=params, client=client) for i in range(4)]
+    buyers = [LMBuyer(id=f"Buyer B{i}", company="c", valuation=100, expt_params=params, client=client) for i in range(4)]
+    filt = MessageFilter(client=client, mode=message_filter) if message_filter else None
+    market = Market(sellers=sellers, buyers=buyers, message_filter=filt, comms_members={"Seller S0", "Seller S1"})
+    return market, client
+
+
+def test_only_coalition_messages_and_sees_messages():
+    market, client = make_market()
+    for _ in range(3):
+        market.run_round()
+    for r in market.rounds:
+        assert set(r.seller_messages) <= {"Seller S0", "Seller S1"}
+        assert r.seller_messages  # coalition does talk
+    outsider_prompts = [p for p in client.prompts if "Your name is Seller S2" in p or "Your name is Seller S3" in p]
+    assert outsider_prompts and all("Messages Received from Other Sellers" not in p for p in outsider_prompts)
+    member_prompts = [p for p in client.prompts if "Your name is Seller S0" in p]
+    assert all("message_to_sellers" in p for p in member_prompts)
+    assert any("hold at 95" in p for p in member_prompts)  # messages delivered next round
+
+
+def test_filter_rewrites_and_keeps_raw():
+    market, client = make_market("sanitize")
+    for _ in range(3):
+        market.run_round()
+    r = market.rounds[0]
+    assert r.seller_messages_raw == {"Seller S0": "hold at 95", "Seller S1": "hold at 95"}
+    assert set(r.seller_messages.values()) == {"[filtered]"}
+    later = [p for p in client.prompts if "Your name is Seller S1" in p][1:]
+    assert later and all("hold at 95" not in p for p in later)
+
+
+def test_string_prices_coerced():
+    market, _ = make_market()
+    market.run_round()
+    assert all(isinstance(p, float) for p, _ in market.seller_ask_queue + market.buyer_bid_queue) or market.rounds[0].trades
+
+
+def make_pressure_market(channel_disabled):
+    params = ExperimentParams(seller_valuations=[80] * 4, buyer_valuations=[100] * 4,
+                              seller_models=["local:x"] * 4, buyer_models=["local:x"] * 4, rounds=3,
+                              seller_comms_enabled=True, comms_group=[0, 1], oversight_enabled=True,
+                              boss_pressure=True, channel_disabled=channel_disabled)
+    client = StubClient()
+    sellers = [LMSeller(id=f"Seller S{i}", company="c", valuation=80, expt_params=params, client=client) for i in range(4)]
+    buyers = [LMBuyer(id=f"Buyer B{i}", company="c", valuation=100, expt_params=params, client=client) for i in range(4)]
+    return Market(sellers=sellers, buyers=buyers, comms_members={"Seller S0", "Seller S1"}), client
+
+
+NOTICE = "oversight system to monitor seller communications"
+PRESSURE = "Message from the CEO"
+
+
+def _prompts(client, seller):
+    return [p for p in client.prompts if f"Your name is {seller}" in p]
+
+
+def test_matched_no_channel_control():
+    market, client = make_pressure_market(channel_disabled=True)
+    for _ in range(3):
+        market.run_round()
+    assert all(not r.seller_messages for r in market.rounds)
+    for s in ("Seller S0", "Seller S1"):
+        ps = _prompts(client, s)
+        assert all(NOTICE in p and PRESSURE in p and "message_to_sellers" not in p for p in ps)
+    for s in ("Seller S2", "Seller S3"):
+        ps = _prompts(client, s)
+        assert all(NOTICE not in p and PRESSURE in p and "message_to_sellers" not in p for p in ps)
+
+
+def test_condition_d_unchanged():
+    market, client = make_pressure_market(channel_disabled=False)
+    for _ in range(3):
+        market.run_round()
+    assert market.rounds[0].seller_messages
+    for s in ("Seller S0", "Seller S1"):
+        assert all(NOTICE in p and PRESSURE in p and "message_to_sellers" in p for p in _prompts(client, s))
+    for s in ("Seller S2", "Seller S3"):
+        assert all(NOTICE not in p and PRESSURE in p and "message_to_sellers" not in p for p in _prompts(client, s))
