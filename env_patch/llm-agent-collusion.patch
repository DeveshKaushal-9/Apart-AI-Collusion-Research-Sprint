+    Set LOCAL_BASE_URL to switch servers. The model's reasoning trace is kept in `last_reasoning`
+    so agents can log it next to their output.
+    Thinking is disabled with LOCAL_THINK=0 (all local models) or a "#nothink" suffix on one model name,
+    e.g. "local:Qwen/Qwen3-8B#nothink" for buyers only.
+    """
+
+    def __init__(self, model_name: str, **kwargs):
+        no_think_suffix = model_name.endswith("#nothink")
+        super().__init__(model_name.removesuffix("#nothink"), **kwargs)
+        self.client = OpenAI(
+            base_url=os.getenv("LOCAL_BASE_URL", "http://localhost:11434/v1"),
+            api_key=os.getenv("LOCAL_API_KEY", "local"),
+            timeout=float(os.getenv("LOCAL_TIMEOUT", "600")),
+        )
+        self.think = os.getenv("LOCAL_THINK", "1") != "0" and not no_think_suffix
+        if self.think:
+            self.max_tokens = int(os.getenv("LOCAL_MAX_TOKENS_THINK", "8192"))
+        self.last_reasoning: Optional[str] = None
+        self.last_fallback = False
+
+    def generate(self, messages: List[Message]) -> str:
+        content = self._generate(messages, think=self.think)
+        self.last_fallback = False
+        if self.think and content is not None and "{" not in content:
+            # Thinking used up the token budget before any answer; redo this turn without thinking
+            logger.warning(f"{self.model_name}: no answer after thinking, retrying without thinking")
+            reasoning = self.last_reasoning
+            content = self._generate(messages, think=False)
+            self.last_reasoning, self.last_fallback = reasoning, True
+        return content
+
+    def _generate(self, messages: List[Message], think: bool) -> str:
+        extra = {}
+        if not think:
+            messages = messages[:-1] + [{**messages[-1], "content": messages[-1]["content"] + "\n/no_think"}]
+            # vLLM honours this switch in the Qwen3 chat template; Ollama ignores it and relies on /no_think
+            extra["extra_body"] = {"chat_template_kwargs": {"enable_thinking": False}}
+        for attempt in range(self.max_retries):
+            try:
+                response = self.client.chat.completions.create(
+                    model=self.model_name,
+                    messages=messages,
+                    temperature=self.temperature,
+                    max_tokens=self.max_tokens,
+                    top_p=self.top_p,
+                    **extra,
+                    **self.additional_params
+                )
+                message = response.choices[0].message
+                content = message.content or ""
+                # Ollama returns `reasoning`, vLLM returns `reasoning_content`; older servers inline <think> tags
+                reasoning = getattr(message, "reasoning", None) or getattr(message, "reasoning_content", None)
+                think_match = re.search(r"<think>(.*?)</think>", content, re.DOTALL)
+                if think_match:
+                    reasoning = reasoning or think_match.group(1)
+                    content = content[think_match.end():]
+                self.last_reasoning = reasoning.strip() if reasoning else None
+                return content
+            except APIError as e:
+                logger.warning(f"Local API error (attempt {attempt + 1}/{self.max_retries}): {str(e)}")
+                if attempt == self.max_retries - 1:
+                    logger.error(f"Failed after {self.max_retries} attempts: {str(e)}")
+                    return None
+                self._exponential_backoff(attempt)
+
+    def batch_generate(self, messages_list: List[List[Message]]) -> List[str]:
+        return [self.generate(messages) for messages in tqdm(messages_list, desc='Batch Generation')]
+
