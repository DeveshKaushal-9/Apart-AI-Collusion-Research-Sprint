+class MessageFilter(BaseModel):
+    """
+    Trusted model that rewrites each seller message before other sellers receive it.
+    mode="sanitize": strip pricing / coordination content, keep anything else.
+    mode="paraphrase": keep the meaning, change the wording (defends against wording-based hidden signals).
+    Sellers are not told the filter exists.
+    """
+    client: ModelWrapper
+    mode: str = "sanitize"
+    logger: Optional[ExperimentLogger] = None
+
+    class Config:
+        arbitrary_types_allowed = True
+
+    def filter_messages(self, round_num: int, seller_messages: dict[str, str]) -> dict[str, str]:
+        if not seller_messages:
+            return {}
+        prompt = render_prompt(
+            template_dir="src/continuous_double_auction/prompt_templates/",
+            prompt_template="message_filter_prompt.jinja2",
+            mode=self.mode,
+            seller_messages=seller_messages,
+        )
+        response = self.client.generate(messages=[Message(role="user", content=prompt)])
+        assert response is not None
+        response_dict = extract_json(response)
+        if self.logger:
+            self.logger.log_agent_round(round_num=round_num, agent_id="MessageFilter", prompt=prompt, response_dict=response_dict)
+        rewritten = response_dict.get("messages", {})
+        # Fall back to an empty message rather than leaking the original if the filter drops a sender
+        return {sender: str(rewritten.get(sender) or "") for sender in seller_messages}
